# Copy this file to .env and adjust the values. The .env file is never committed.
# These defaults only suit a local demonstration.

# --- PostgreSQL container (read by Docker Compose)
POSTGRES_USER=zolive
POSTGRES_PASSWORD=local-demo-only
POSTGRES_DB=zolive

# --- Application
# Connection URL used by `pnpm dev`. In the demonstration profile, Docker Compose
# builds its own URL pointing at the internal `db` host.
DATABASE_URL=postgres://zolive:local-demo-only@localhost:5432/zolive

# Public base URL of the site.
APP_URL=http://localhost:3000

# Optional: database used by the integration tests (pnpm test:integration). It is created
# on first run, next to the development database, and never shared with it.
# TEST_DATABASE_URL=postgres://zolive:local-demo-only@localhost:5432/zolive_test

# Optional: local port published by the demonstration profile (default 3000).
# Change it, together with APP_URL, when the port is already taken.
# APP_PORT=3000
